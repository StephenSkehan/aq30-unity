  m_Script: {fileID: 11500000, guid: 7e8140d05737a11468020c371c32ff33, type: 3}
  m_Name: Resolve_E1_Archive
  m_EditorClassIdentifier: AQ.App::AQ.App.CaseGraph
  startId: E1_L3_N1
  stageBackground: {fileID: 21300000, guid: b61e15d0a1b2c3d4e5f6a7b8c9d0e101, type: 3}
  nodes:
  - id: E1_L3_N1
    speaker: "Ally Quinn"
    line: "Three years of messages, most under a minute. I'd often pick one to close the show. Dot knew: she'd hear herself on the next episode, and answer in the next message. \"Play the one about the gulls,\" she said in one of them. \"I was very good in that one.\""
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag:
    skipIfFlagMissing: 1
    setsFlag:
    nextId: E1_L3_N2
    choices: []
  - id: E1_L3_N2
    speaker: "Ally Quinn"
    line: "Tonight they're not a heartwarming outro. They're pins on a map. A school bell in the daytime messages, so close she'd need to raise her voice over it. And under the late calls, a low mechanical note every twenty-odd seconds."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag:
    skipIfFlagMissing: 1
    setsFlag:
    nextId: E1_L3_N3
    choices: []
  - id: E1_L3_N3
    speaker: "Ally Quinn"
    line: "And the boats. She loved the boats. Years of them, mentioned like weather. Then three weeks ago, her tone was different: \"the pretty one came very close tonight. Two-note horn, no lights, and a funny mark on the funnel, like a fish-hook.\" I played that one on the show."
    portrait: {fileID: 21300000, guid: e02460f0c092dde4891723eecbbdc368, type: 3}
    emotion: 5
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag:
    skipIfFlagMissing: 1
    setsFlag:
    nextId: E1_L3_N4
    choices: []
  - id: E1_L3_N4
    speaker: "Ally Quinn"
    line: "A school bell she had to talk over. A machine that breathes every twenty seconds. Grandad has heard every sound this city has ever made. Time to buy Gerald a drink."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag:
    skipIfFlagMissing: 1
    setsFlag: aq.lead.e1_archive.seen
    nextId:
    choices: []
