  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7e8140d05737a11468020c371c32ff33, type: 3}
  m_Name: Resolve_E1_Bridge
  m_EditorClassIdentifier: AQ.App::AQ.App.CaseGraph
  startId: E1_L4_M1
  stageBackground: {fileID: 21300000, guid: b61e15d0a1b2c3d4e5f6a7b8c9d0e104, type: 3}
  nodes:
  - id: E1_L4_M1
    speaker: "Mo Callahan"
    line: "Well, look what the tide brings. The corner booth, my lovely. Where else would he be? Go on through. I'll bring the usuals."
    portrait: {fileID: 21300000, guid: a10caa11a7a1b2c3d4e5f6a7b8c9d002, type: 3}
    emotion: 1
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag:
    skipIfFlagMissing: 1
    setsFlag:
    nextId: E1_L4_N1
    choices: []
  - id: E1_L4_N1
    speaker: "Ally Quinn"
    line: "Grandad hugs like he's checking for broken ribs. Once I'd passed inspection, I handed him the headphones, plugged them into my phone, and told him what was on them. He didn't flinch. He turned the volume up."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag:
    skipIfFlagMissing: 1
    setsFlag:
    nextId: E1_L4_N2
    choices: []
  - id: E1_L4_N2
    speaker: "Gerald Quinn"
    line: "Loop the low note for me, love. Just that. Nothing else in my ears."
    portrait: {fileID: 21300000, guid: c3a4b5d6e7f8c3a4b5d6e7f8c3a4b5d6, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag:
    skipIfFlagMissing: 1
    setsFlag:
    nextId: E1_L4_N3
    choices: []
  - id: E1_L4_N3
    speaker: "Ally Quinn"
    line: "I'd already split the recording into separate tracks, one for every sound in her hall. I set the low note looping, alone. He counted under his breath, pencil ticking the table. Then he took the headphones off. Twenty-two seconds."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag:
    skipIfFlagMissing: 1
    setsFlag:
    nextId: E1_L4_N4
    choices: []
  - id: E1_L4_N4
    speaker: "Gerald Quinn"
    line: "That's the old pump house at Rivermouth reach. It clears the channel when the tide drops. One breath every twenty-two seconds. Your Dot sleeps close enough to hear it. Mind how you go down there."
    portrait: {fileID: 21300000, guid: c3a4b5d6e7f8c3a4b5d6e7f8c3a4b5db, type: 3}
    emotion: 5
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag:
    skipIfFlagMissing: 1
    setsFlag:
    nextId: E1_L4_N5
    choices: []
  - id: E1_L4_N5
    speaker: "Ally Quinn"
    line: "On the way out, I played Mo a few seconds of Dot's voice. She stopped polishing the glass."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag:
    skipIfFlagMissing: 1
    setsFlag:
    nextId: E1_L4_M2
    choices: []
  - id: E1_L4_M2
    speaker: "Mo Callahan"
    line: "Dorothy Ellis. Cleaned Chandler Road school for thirty years. Quiz night tonight, table six. She's never once missed it."
    portrait: {fileID: 21300000, guid: a10caa11a7a1b2c3d4e5f6a7b8c9d006, type: 3}
    emotion: 5
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag:
    skipIfFlagMissing: 1
    setsFlag:
    nextId: E1_L4_N6
    choices: []
  - id: E1_L4_N6
    speaker: "Ally Quinn"
    line: "Okay. Rivermouth. Chandler Road. We're getting closer."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag:
    skipIfFlagMissing: 1
    setsFlag: aq.lead.e1_bridge.seen
    nextId:
    choices: []
