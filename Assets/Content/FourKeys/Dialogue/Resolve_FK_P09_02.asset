  nodes:
  - id: FK_P09_02_N1
    speaker: "Ally Quinn"
    line: "Cross-check one. I asked each of them, on their own, what colour the ground was. Black, four times."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
