    setsFlag: 
    nextId: FK_P09_02_N2
    choices: []
  - id: FK_P09_02_N2
    speaker: "Ally Quinn"
    line: "The lettering. Gold capitals, four times. And an ampersand in the middle of it, four times."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P09_02_N3
    choices: []
  - id: FK_P09_02_N3
    speaker: "Ally Quinn"
    line: "Four people who never sat together until tonight, and the letters agree."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
