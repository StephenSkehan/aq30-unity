  m_Name: Resolve_FK_P03_03
  m_EditorClassIdentifier: AQ.App::AQ.App.CaseGraph
  startId: FK_P03_03_N1
  stageBackground: {fileID: 21300000, guid: b61e15d0a1b2c3d4e5f6a7b8c9d0e106, type: 3}
  nodes:
  - id: FK_P03_03_N1
    speaker: "Ally Quinn"
    line: "Violet's sister administers the estate. She didn't get on with Violet and doesn't pretend she did. She met me in the street."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P03_03_N2
    choices: []
  - id: FK_P03_03_N2
    speaker: "Violet's sister"
    line: "We fought over Mum's house for years. Years. She had a solicitor on Civic Row for it. Then she dies with no will and I get all of it anyway. Every box."
    portrait: {fileID: 0}
    emotion: 3
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P03_03_N3
    choices: []
  - id: FK_P03_03_N3
    speaker: "Violet's sister"
    line: "You want to know what was beside that letter? Mum's ashes. Four years on a shelf. She told me she'd scattered them. A friend brought them back to me in a tube, ten weeks after, and wouldn't say where they'd been. Only that Violet locked them in that store."
    portrait: {fileID: 0}
    emotion: 3
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P03_03_N4
    choices: []
  - id: FK_P03_03_N4
    speaker: "Ally Quinn"
    line: "So that's what stood beside the letter. Their mother's ashes. The four have never said it. The sister has them now."
    portrait: {fileID: 21300000, guid: a6ca2348df1d653488455433cabdac99, type: 3}
    emotion: 2
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: 
    choices: []
