  startId: FK_P03_07_N1
  stageBackground: {fileID: 21300000, guid: b61e15d0a1b2c3d4e5f6a7b8c9d0e106, type: 3}
  nodes:
  - id: FK_P03_07_N1
    speaker: "Ally Quinn"
    line: "Two signwriters up the coast saw the panel. I drove up and asked them to describe it. First pass, nothing more."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P03_07_N2
    choices: []
  - id: FK_P03_07_N2
    speaker: "The first signwriter"
    line: "Gold on a dark ground. A whole alphabet, capitals. Her style, no question, but better than I'd ever seen her do. I said, if it's anyone it's you, in a very good year. I wouldn't have sworn to it."
    portrait: {fileID: 0}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P03_07_N3
    choices: []
  - id: FK_P03_07_N3
    speaker: "The second signwriter"
    line: "I couldn't place the hand, and that's rare for me. Her letters, but not her day. I asked had she shown her lad. And there was a small mark in one corner. I asked what it was. She didn't say."
    portrait: {fileID: 0}
    emotion: 6
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P03_07_N4
    choices: []
  - id: FK_P03_07_N4
    speaker: "Ally Quinn"
    line: "Lettering neither of them would swear to, and a small mark in one corner. I don't know what the mark is. Neither did they."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: 
    choices: []
