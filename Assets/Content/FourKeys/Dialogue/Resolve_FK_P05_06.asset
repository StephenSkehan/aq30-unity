  startId: FK_P05_06_N1
  stageBackground: {fileID: 21300000, guid: 2451cd1fa43fb724bacf7ad8ad419c9b, type: 3}
  nodes:
  - id: FK_P05_06_N1
    speaker: "Ally Quinn"
    line: "A listener went back to the public record this week, and read something I'd read a dozen times without stopping."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P05_06_N2
    choices: []
  - id: FK_P05_06_N2
    speaker: "Ally Quinn"
    line: "Violet's neighbour at number 14 told police, on the day Violet was found, that she'd seen a man in the lane behind Violet's house the night before. About half past ten."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P05_06_N3
    choices: []
  - id: FK_P05_06_N3
    speaker: "Ally Quinn"
    line: "His back to her, going out the back way. A coat. Hands empty. No more than that."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P05_06_N4
    choices: []
  - id: FK_P05_06_N4
    speaker: "Ally Quinn"
    line: "That's been in the record for nine months. Nobody was hiding it. It just sat there."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P05_06_N5
    choices: []
  - id: FK_P05_06_N5
    speaker: "Ally Quinn"
    line: "The listener set the neighbour's description of his build against Liam Bryce. Liam is a big man. Anyone in Havenbay would tell you that."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P05_06_N6
    choices: []
  - id: FK_P05_06_N6
    speaker: "Ally Quinn"
    line: "So the listener's question is this. Was the man in the lane the wrong build for Liam? I'm putting it to you exactly as it was put to me. I don't have the answer."
    portrait: {fileID: 21300000, guid: e02460f0c092dde4891723eecbbdc368, type: 3}
    emotion: 5
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: 
    choices: []
