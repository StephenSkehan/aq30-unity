  m_Name: Resolve_FK_P01_06
  m_EditorClassIdentifier: AQ.App::AQ.App.CaseGraph
  startId: FK_P01_06_N1
  stageBackground: {fileID: 21300000, guid: b61e15d0a1b2c3d4e5f6a7b8c9d0e102, type: 3}
  nodes:
  - id: FK_P01_06_N1
    speaker: "Ally Quinn"
    line: "The four friends called each other that night. They agreed that nobody would open the door alone. They'd wait until Saturday, when all four of them could be there together."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag:
    skipIfFlagMissing: 1
    setsFlag:
    nextId: FK_P01_06_N2
    choices: []
  - id: FK_P01_06_N2
    speaker: "Ally Quinn"
    line: "And when they finally opened it, they found another letter."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag:
    skipIfFlagMissing: 1
    setsFlag:
    nextId: FK_P01_06_N3
    choices: []
  - id: FK_P01_06_N3
    speaker: "Ally Quinn"
    line: "This one didn't say she thought. It said she knew."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag:
    skipIfFlagMissing: 1
    setsFlag:
    nextId: FK_P01_06_N4
    choices: []
  - id: FK_P01_06_N4
    speaker: "Ally Quinn"
    line: "There was an object beside it. Something that had belonged to Violet. Two of the friends are still alive, and neither one will say what that object was."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag:
    skipIfFlagMissing: 1
    setsFlag:
    nextId: 
    choices: []
