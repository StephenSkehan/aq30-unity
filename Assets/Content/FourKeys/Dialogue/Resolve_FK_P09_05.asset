  m_Script: {fileID: 11500000, guid: 7e8140d05737a11468020c371c32ff33, type: 3}
  m_Name: Resolve_FK_P09_05
  m_EditorClassIdentifier: AQ.App::AQ.App.CaseGraph
  startId: FK_P09_05_N1
  stageBackground: {fileID: 21300000, guid: 2451cd1fa43fb724bacf7ad8ad419c9b, type: 3}
  nodes:
  - id: FK_P09_05_N1
    speaker: "Ally Quinn"
    line: "I'm not saying this part on air. This is for the board."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P09_05_N2
    choices: []
  - id: FK_P09_05_N2
    speaker: "Ally Quinn"
    line: "Violet Moore ranked handwriting out loud. Menus, shopfronts, notes on a fridge. By every account I've got, she couldn't help it."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P09_05_N3
    choices: []
  - id: FK_P09_05_N3
    speaker: "Ally Quinn"
    line: "For a month, she couldn't place this one. She said so, and kept saying so."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P09_05_N4
    choices: []
  - id: FK_P09_05_N4
    speaker: "Ally Quinn"
    line: "The two signwriters told me the same thing, separately. It's her alphabet. Her own letters. Done better than she could do them."
    portrait: {fileID: 21300000, guid: e02460f0c092dde4891723eecbbdc368, type: 3}
    emotion: 5
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P09_05_N5
    choices: []
  - id: FK_P09_05_N5
    speaker: "Ally Quinn"
    line: "There's one other signwriter in her life. Her apprentice for seven years. Brad Collins is presumed dead."
    portrait: {fileID: 21300000, guid: e02460f0c092dde4891723eecbbdc368, type: 3}
    emotion: 5
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P09_05_N6
    choices: []
  - id: FK_P09_05_N6
    speaker: "Ally Quinn"
    line: "I'm putting those three things next to each other on the board. I'm not putting them next to each other on air."
    portrait: {fileID: 21300000, guid: a6ca2348df1d653488455433cabdac99, type: 3}
    emotion: 2
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: 
    choices: []
