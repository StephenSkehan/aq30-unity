  stageBackground: {fileID: 21300000, guid: b61e15d0a1b2c3d4e5f6a7b8c9d0e101, type: 3}
  nodes:
  - id: FK_P03_09_N1
    speaker: "Ally Quinn"
    line: "Every week I look at where the show gets downloaded. Havenbay first, then the coast, then the cities. Then one town, four hundred miles away."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P03_09_N2
    choices: []
  - id: FK_P03_09_N2
    speaker: "Ally Quinn"
    line: "Every week since the show began. The same town. I don't know anyone there."
    portrait: {fileID: 21300000, guid: ae0c3985c1991244d8ee72fa0756eb08, type: 3}
    emotion: 6
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P03_09_N3
    choices: []
  - id: FK_P03_09_N3
    speaker: "Ally Quinn"
    line: "I haven't told anyone and I'm not airing it. It doesn't mean anything yet. It's got my attention, that's all."
    portrait: {fileID: 21300000, guid: e02460f0c092dde4891723eecbbdc368, type: 3}
    emotion: 5
    voiceClip: {fileID: 0}
