  startId: FK_P07_01V_N1
  stageBackground: {fileID: 21300000, guid: b61e15d0a1b2c3d4e5f6a7b8c9d0e101, type: 3}
  nodes:
  - id: FK_P07_01V_N1
    speaker: "Ally Quinn"
    line: "I aired Margo's exact words. By morning they had travelled beyond this podcast, detached from the care Tessa had put around them."
    portrait: {fileID: 21300000, guid: e02460f0c092dde4891723eecbbdc368, type: 3}
    emotion: 5
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: aq.fk.d3.verbatim
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P07_01V_N2
    choices: []
  - id: FK_P07_01V_N2
    speaker: "Ally Quinn"
    line: "A stranger up the coast recognised the phrasing as part of a private message and contacted Tessa."
    portrait: {fileID: 21300000, guid: e02460f0c092dde4891723eecbbdc368, type: 3}
    emotion: 5
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: aq.fk.d3.verbatim
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P07_01V_N3
    choices: []
  - id: FK_P07_01V_N3
    speaker: "Ally Quinn"
    line: "Tessa rang frightened. She had agreed to the words, not to being found through them."
    portrait: {fileID: 21300000, guid: a6ca2348df1d653488455433cabdac99, type: 3}
    emotion: 2
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: aq.fk.d3.verbatim
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P07_01V_N4
    choices: []
  - id: FK_P07_01V_N4
    speaker: "Ally Quinn"
    line: "She has stopped answering me. I still have the screenshot. I no longer have her trust."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: aq.fk.d3.verbatim
    skipIfFlagMissing: 1
    setsFlag: 
