  stageBackground: {fileID: 21300000, guid: b61e15d0a1b2c3d4e5f6a7b8c9d0e107, type: 3}
  nodes:
  - id: FK_P08_02_N1
    speaker: "Ally Quinn"
    line: "The skipper sets out the man's harbour years the way he knew them. He lived aboard. He kept a dry bag at a mate's place ashore. He drank in town when the boat was in."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P08_02_N2
    choices: []
  - id: FK_P08_02_N2
    speaker: "Ally Quinn"
    line: "One morning he missed a sailing. The boat went without him. That was the last of it."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P08_02_N3
    choices: []
  - id: FK_P08_02_N3
    speaker: "Ally Quinn"
    line: "He had a first name and a trade. Nobody ever asked him for more than that, and now there's nobody to ask."
    portrait: {fileID: 21300000, guid: a6ca2348df1d653488455433cabdac99, type: 3}
    emotion: 2
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
