  nodes:
  - id: FK_P08_07_N1
    speaker: "Ally Quinn"
    line: "The clerk at the halt remembers the man because of the note. Twenty to six, first sale of the day, and he had to break a note to do it. He complained out loud."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
