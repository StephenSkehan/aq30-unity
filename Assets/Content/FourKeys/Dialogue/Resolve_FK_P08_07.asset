    setsFlag: 
    nextId: FK_P08_07_N2
    choices: []
  - id: FK_P08_07_N2
    speaker: "Ally Quinn"
    line: "He remembered the boots because of the complaint. He'd have forgotten the man otherwise. It's the small annoyances that keep."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
