MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7e8140d05737a11468020c371c32ff33, type: 3}
  m_Name: Resolve_FK_P10_10H
  m_EditorClassIdentifier: AQ.App::AQ.App.CaseGraph
  startId: FK_P10_10H_N1
  stageBackground: {fileID: 21300000, guid: b61e15d0a1b2c3d4e5f6a7b8c9d0e102, type: 3}
  nodes:
  - id: FK_P10_10H_N1
    speaker: "Ally Quinn"
    line: "A short update, released tonight, hours after the news. Not an episode. What I know at nine o'clock."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P10_10H_N2
    choices: []
  - id: FK_P10_10H_N2
    speaker: "Ally Quinn"
    line: "Brad Collins is alive. He was arrested this morning, four hundred miles from here, under a name that had sat three years in a missing-person file. That undoes a lot. The month this show spent on a dead man, for a start."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P10_10H_N3
    choices: []
  - id: FK_P10_10H_N3
    speaker: "Ally Quinn"
    line: "The war between Liam and Ruby is over. They were in the same room this week, for the first time since the sixth week. The woman who wrote to me won't be named on this show. She asked for that and she has it."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P10_10H_N4
    choices: []
  - id: FK_P10_10H_N4
    speaker: "Ally Quinn"
    line: "Tessa rang me tonight, the first time since the summer. She said the exact words were worth it. That's hers to say, and she said it."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: aq.fk.d3.verbatim
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P10_10H_N5
    choices: []
  - id: FK_P10_10H_N5
    speaker: "Ally Quinn"
    line: "Tessa told me she was glad the words that went out weren't hers. That's hers to say, and she said it."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: aq.fk.d3.paraphrase
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P10_10H_N6
    choices: []
  - id: FK_P10_10H_N6
    speaker: "Ally Quinn"
    line: "Violet's sister asked Liam this time, and he took her and their mother out to the point on his boat. Ruby carried the tube down the slip."
    portrait: {fileID: 21300000, guid: a6ca2348df1d653488455433cabdac99, type: 3}
    emotion: 2
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P10_10H_N7
    choices: []
  - id: FK_P10_10H_N7
    speaker: "Ally Quinn"
    line: "I don't know what was in the true letter, or whether there was one. What's on the record is only what could be checked. And I know a man believed dead was in a room with a black and gold thing on his wall."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P10_10H_N8
    choices: []
  - id: FK_P10_10H_N8
    speaker: "Ally Quinn"
    line: "What I described, I erased. The gap on his wall appeared the day after the description aired. The rest stays in a file, where it did its work. This is Echoes of Havenbay, I'm Ally Quinn. Goodnight for now, Harbour. Sleep tight."
    portrait: {fileID: 21300000, guid: a6ca2348df1d653488455433cabdac99, type: 3}
    emotion: 2
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: 
    choices: []
