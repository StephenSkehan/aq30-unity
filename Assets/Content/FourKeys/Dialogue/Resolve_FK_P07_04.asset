  m_Script: {fileID: 11500000, guid: 7e8140d05737a11468020c371c32ff33, type: 3}
  m_Name: Resolve_FK_P07_04
  m_EditorClassIdentifier: AQ.App::AQ.App.CaseGraph
  startId: FK_P07_04_N1
  stageBackground: {fileID: 21300000, guid: 2451cd1fa43fb724bacf7ad8ad419c9b, type: 3}
  nodes:
  - id: FK_P07_04_N1
    speaker: "Ally Quinn"
    line: "When did each of them read theirs? Ruby, off night shifts, woke about three and read hers at half past three. The note said together, so she sat with it and rang Liam at five, when the crane stopped."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P07_04_N2
    choices: []
  - id: FK_P07_04_N2
    speaker: "Ally Quinn"
    line: "Liam read his at half past five, in the yard's afternoon post. He rang Brad at a quarter to six. Ruby rang Margo at six, by her memory."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P07_04_N3
    choices: []
  - id: FK_P07_04_N3
    speaker: "Ally Quinn"
    line: "Liam told Brad his had come in the afternoon post and asked had Brad seen his. Brad said: same, nothing in the box this morning, it must have come in the afternoon sort. That's Liam's account, on the record."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P07_04_N4
    choices: []
  - id: FK_P07_04_N4
    speaker: "Ally Quinn"
    line: "Brad cleared his box at seven every working morning, on the way to the first job. The number's on the side of his van. The counter says one sort a day, overnight, in the boxes before seven. There's never been an afternoon sort."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: 
    choices: []
