MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7e8140d05737a11468020c371c32ff33, type: 3}
  m_Name: Resolve_FK_P06_10
  m_EditorClassIdentifier: AQ.App::AQ.App.CaseGraph
  startId: FK_P06_10_N1
  stageBackground: {fileID: 21300000, guid: b61e15d0a1b2c3d4e5f6a7b8c9d0e102, type: 3}
  nodes:
  - id: FK_P06_10_N1
    speaker: "Ally Quinn"
    line: "Last week I asked whether Margo Rivera said anything, to anyone. Three days of nothing. Then one answer. One."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P06_10_N2
    choices: []
  - id: FK_P06_10_N2
    speaker: "Ally Quinn"
    line: "Here's what I can tell you. The letter in Violet's locker listed things that were wrong in her house. The police checked every line they could, and every line held."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P06_10_N3
    choices: []
  - id: FK_P06_10_N3
    speaker: "Ally Quinn"
    line: "One line nobody checked, because it was kind. And one thing Violet had in her last months, a gilded panel she showed round the trade, that nobody has seen since. Not in the locker. Not anywhere I can find."
    portrait: {fileID: 21300000, guid: e02460f0c092dde4891723eecbbdc368, type: 3}
    emotion: 5
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P06_10_N4
    choices: []
  - id: FK_P06_10_N4
    speaker: "Ally Quinn"
    line: "I'm not telling you the letter's false. I'm not telling you who. I'm telling you something is missing from the world, and if you've seen it, write to me, not to anyone else."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P06_10_N5
    choices: []
  - id: FK_P06_10_N5
    speaker: "Ally Quinn"
    line: "The four of them had a name for Violet's locker. The cupboard. And Margo Rivera, who everybody thought said nothing, said one thing about it."
    portrait: {fileID: 21300000, guid: a6ca2348df1d653488455433cabdac99, type: 3}
    emotion: 2
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P06_10_N6
    choices: []
  - id: FK_P06_10_N6
    speaker: "Ally Quinn"
    line: "Seventy-seven days after Violet died, she wrote to a woman two hours up the coast: The thing in the cupboard is wrong. It can't mean that. This is Echoes of Havenbay, I'm Ally Quinn. Goodnight for now, Harbour. Sleep tight."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: aq.fk.d3.verbatim
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P06_10_N7
    choices: []
  - id: FK_P06_10_N7
    speaker: "Ally Quinn"
    line: "Margo doubted what was in the cupboard. Not that it was Violet's. What it meant. She said so once, to one person, and never again. This is Echoes of Havenbay, I'm Ally Quinn. Goodnight for now, Harbour. Sleep tight."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: aq.fk.d3.paraphrase
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: 
    choices: []
