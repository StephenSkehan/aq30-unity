  stageBackground: {fileID: 21300000, guid: b61e15d0a1b2c3d4e5f6a7b8c9d0e108, type: 3}
  nodes:
  - id: FK_P10_02_N1
    speaker: "Ally Quinn"
    line: "Seven o'clock the same morning I was on Del's bench with all of it. Her message. The address. And the download map beside it, the one town that had been listening since the third week."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P10_02_N2
    choices: []
  - id: FK_P10_02_N2
    speaker: "Del Cruz"
    line: "Same town. Right. Go home, Ally. Don't ring me today. I'll ring you."
    portrait: {fileID: 21300000, guid: de1a4b5c6d7e8f90a1b2c3d4e5f6a701, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P10_02_N3
    choices: []
  - id: FK_P10_02_N3
    speaker: "Ally Quinn"
    line: "She moved inside the day. By that evening it wasn't hers any more. Another force had it, four hundred miles up the map, and that's the last thing I'm going to say about them."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
