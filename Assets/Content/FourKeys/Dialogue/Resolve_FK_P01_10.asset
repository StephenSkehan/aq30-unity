  startId: FK_P01_10_N1
  stageBackground: {fileID: 0}
  nodes:
  - id: FK_P01_10_N1
    speaker: "Ally Quinn"
    line: "Now Liam and Ruby are accusing each other publicly, and Violet's warning is tearing them apart as Havenbay takes sides."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag:
    skipIfFlagMissing: 1
    setsFlag:
    nextId: FK_P01_10_N2
    choices: []
  - id: FK_P01_10_N2
    speaker: "Ally Quinn"
    line: "Ruby has agreed to speak with me. Liam hasn't. At least, not yet."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag:
    skipIfFlagMissing: 1
    setsFlag:
    nextId: FK_P01_10_N3
    choices: []
  - id: FK_P01_10_N3
    speaker: "Ally Quinn"
    line: "I don't know what was behind that locked door. I don't know whether Violet really identified her killer. And I don't know whether Liam or Ruby has a reason to be afraid."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag:
    skipIfFlagMissing: 1
    setsFlag:
    nextId: FK_P01_10_N4
    choices: []
  - id: FK_P01_10_N4
    speaker: "Ally Quinn"
    line: "But four friends received four keys."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag:
    skipIfFlagMissing: 1
    setsFlag:
    nextId: FK_P01_10_N5
    choices: []
  - id: FK_P01_10_N5
    speaker: "Ally Quinn"
    line: "Nine months later, two of them are dead, and the other two believe one of them could be next."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag:
    skipIfFlagMissing: 1
    setsFlag:
    nextId: FK_P01_10_N6
    choices: []
  - id: FK_P01_10_N6
    speaker: "Ally Quinn"
    line: "So that's where we begin."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag:
    skipIfFlagMissing: 1
    setsFlag:
    nextId: FK_P01_10_N7
    choices: []
  - id: FK_P01_10_N7
    speaker: "Ally Quinn"
    line: "With Violet, her four friends and the door she wanted them to open."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag:
    skipIfFlagMissing: 1
    setsFlag:
    nextId: FK_P01_10_N8
    choices: []
  - id: FK_P01_10_N8
    speaker: "Ally Quinn"
    line: "This is Echoes of Havenbay, I'm Ally Quinn. Goodnight for now, Harbour. Sleep tight."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
