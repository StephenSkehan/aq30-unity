  m_Name: Resolve_FK_P07_10
  m_EditorClassIdentifier: AQ.App::AQ.App.CaseGraph
  startId: FK_P07_10_N1
  stageBackground: {fileID: 21300000, guid: b61e15d0a1b2c3d4e5f6a7b8c9d0e102, type: 3}
  nodes:
  - id: FK_P07_10_N1
    speaker: "Ally Quinn"
    line: "Seven aired, and the post came in the way it does after an ask. More than any week before. It's stacked on the floor because the table's full."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P07_10_N2
    choices: []
  - id: FK_P07_10_N2
    speaker: "Ally Quinn"
    line: "I've sorted it by hand. Most of it is kind, some of it is angry, and I've read all of it but two. Those two I've set to one side, unopened. I know enough from the outside of them to know they matter."
    portrait: {fileID: 21300000, guid: e02460f0c092dde4891723eecbbdc368, type: 3}
    emotion: 5
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P07_10_N3
    choices: []
  - id: FK_P07_10_N3
    speaker: "Ally Quinn"
    line: "I'll read them before I say a word about them. Here's how I closed the episode."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P07_10_N4
    choices: []
  - id: FK_P07_10_N4
    speaker: "Ally Quinn"
    line: "I've asked you one thing tonight and I'll ask it again. If you saw Brad Collins on the morning the keys came, write to me, not to anyone else. This is Echoes of Havenbay, I'm Ally Quinn. Goodnight for now, Harbour. Sleep tight."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: 
    choices: []
