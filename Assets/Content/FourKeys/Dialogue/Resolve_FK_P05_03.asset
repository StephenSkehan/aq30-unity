  nodes:
  - id: FK_P05_03_N1
    speaker: "Ruby Walker"
    line: "Violet painted her office door, years back. Charged her about half what it was worth, because Violet did that."
    portrait: {fileID: 21300000, guid: 3eda8c3a8ba44593b8d95260ba6b7487, type: 3}
