  startId: FK_P05_07_N1
  stageBackground: {fileID: 21300000, guid: c26f32895ad18bd46be4538d6056e914, type: 3}
  nodes:
  - id: FK_P05_07_N1
    speaker: "Ally Quinn"
    line: "Margo was ten minutes early to everything. Always ten. Not five, not fifteen. Ruby says she'd sit in the car until the hour and then walk in on the minute."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P05_07_N2
    choices: []
  - id: FK_P05_07_N2
    speaker: "Ally Quinn"
    line: "Her car was found at Kestrel Head, the headland car park where Brad left his. The dashboard clock read ten minutes before eleven."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P05_07_N3
    choices: []
  - id: FK_P05_07_N3
    speaker: "Ally Quinn"
    line: "Ten minutes early. She went to that car park the way she went everywhere."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P05_07_N4
    choices: []
  - id: FK_P05_07_N4
    speaker: "Ally Quinn"
    line: "I don't know what that means. I know it's her. That's as far as I can take it."
    portrait: {fileID: 21300000, guid: e02460f0c092dde4891723eecbbdc368, type: 3}
    emotion: 5
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
