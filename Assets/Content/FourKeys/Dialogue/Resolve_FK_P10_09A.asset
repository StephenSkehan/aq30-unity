  m_Script: {fileID: 11500000, guid: 7e8140d05737a11468020c371c32ff33, type: 3}
  m_Name: Resolve_FK_P10_09A
  m_EditorClassIdentifier: AQ.App::AQ.App.CaseGraph
  startId: FK_P10_09A_N1
  stageBackground: {fileID: 21300000, guid: 2451cd1fa43fb724bacf7ad8ad419c9b, type: 3}
  nodes:
  - id: FK_P10_09A_N1
    speaker: "Ally Quinn"
    line: "I've gone back over Margo. Everything she did in the middle weeks, I've put in a different order."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P10_09A_N2
    choices: []
  - id: FK_P10_09A_N2
    speaker: "Ally Quinn"
    line: "There was one line in the letter nobody at Ruby's table could check. The line about Brad and the van money. And in the seventh week, the estate asked Margo about that money."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P10_09A_N3
    choices: []
  - id: FK_P10_09A_N3
    speaker: "Ally Quinn"
    line: "She said one thing, to one person, and to nobody else. The thing in the cupboard is wrong. And she stepped back from a friend she loved rather than say it at a table where he sat."
    portrait: {fileID: 21300000, guid: e02460f0c092dde4891723eecbbdc368, type: 3}
    emotion: 5
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P10_09A_N4
    choices: []
  - id: FK_P10_09A_N4
    speaker: "Ally Quinn"
    line: "I don't know what Margo knew. I know what fits. The frightened one, the one who went quiet, may have been the only friend who read the letter's one kindness for what it was."
    portrait: {fileID: 21300000, guid: a6ca2348df1d653488455433cabdac99, type: 3}
    emotion: 2
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P10_09A_N5
    choices: []
  - id: FK_P10_09A_N5
    speaker: "Ally Quinn"
    line: "That's the reading. It's mine, and it stays mine. With the mark out there, the record's too loud now to check anything softer against it. Margo's one sentence will never be more than what fits."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: 
    choices: []
