  nodes:
  - id: FK_P05_04_N1
    speaker: "Ally Quinn"
    line: "Every Tuesday Violet left a bag of receipts at Margo's office. Loose, in a carrier bag, for sorting."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P05_04_N2
    choices: []
  - id: FK_P05_04_N2
    speaker: "Ally Quinn"
    line: "Every Friday she collected it, untouched. Margo did the sorting herself. Every week."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P05_04_N3
    choices: []
  - id: FK_P05_04_N3
    speaker: "Ally Quinn"
    line: "Ruby says it had been a joke between them once. Violet's bag. I don't know when it stopped being funny."
    portrait: {fileID: 21300000, guid: a6ca2348df1d653488455433cabdac99, type: 3}
