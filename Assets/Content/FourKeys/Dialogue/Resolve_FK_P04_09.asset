  m_Script: {fileID: 11500000, guid: 7e8140d05737a11468020c371c32ff33, type: 3}
  m_Name: Resolve_FK_P04_09
  m_EditorClassIdentifier: AQ.App::AQ.App.CaseGraph
  startId: FK_P04_09_N1
  stageBackground: {fileID: 21300000, guid: b61e15d0a1b2c3d4e5f6a7b8c9d0e101, type: 3}
  nodes:
  - id: FK_P04_09_N1
    speaker: "Ally Quinn"
    line: "Late in the week a boat owner rang the Tip Line. He works the slip before the tide and knew Violet by sight. She lettered his boat."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P04_09_N2
    choices: []
  - id: FK_P04_09_N2
    speaker: "The boat owner"
    line: "The Monday the notes came, I was down there at twenty past seven. A young man was in the corridor with something flat under his arm. He was near one of the doors. From where I stood, I couldn't tell which door, and I wouldn't swear to the man."
    portrait: {fileID: 0}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P04_09_N3
    choices: []
  - id: FK_P04_09_N3
    speaker: "Ally Quinn"
    line: "That was hours before the four came at night. It is enough to file, not enough to name anyone. It is not going on air."
    portrait: {fileID: 21300000, guid: e02460f0c092dde4891723eecbbdc368, type: 3}
    emotion: 5
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P04_09_D
    choices: []
  - id: FK_P04_09_D
    speaker: "Ally Quinn"
    line: "Who gets the first clean look?"
    portrait: {fileID: 21300000, guid: e02460f0c092dde4891723eecbbdc368, type: 3}
    emotion: 5
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P04_09_R1
    choices:
    - text: "Send Del the clean tip"
      nextId: FK_P04_09_R1
      requiresFlag: 
    - text: "Map the sheds first"
      nextId: FK_P04_09_R2
      requiresFlag: 
  - id: FK_P04_09_R1
    speaker: "Ally Quinn"
    line: "Del got the account clean. She asked me to stay off the sheds while they work it, and I said yes. I will not see the corridor again or ask the boat owner twice."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: aq.fk.d2.direct
    nextId: FK_P04_09_N4
    choices: []
  - id: FK_P04_09_R2
    speaker: "Ally Quinn"
    line: "I spent a day there first. I gained a second witness and the corridor layout. Del got it a day late, and Liam stopped answering me."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: aq.fk.d2.market
    nextId: FK_P04_09_N4
    choices: []
  - id: FK_P04_09_N4
    speaker: "Ally Quinn"
    line: "Either way, I am holding an unnamed man, something flat and an early hour. Nothing more."
    portrait: {fileID: 21300000, guid: e02460f0c092dde4891723eecbbdc368, type: 3}
    emotion: 5
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: 
    choices: []
