  nodes:
  - id: FK_P01_09_N1
    speaker: "Ally Quinn"
    line: "Police examined Violet's letters and found no reason to believe they were fake. They looked into Liam. They looked into Ruby. They found nothing they could use."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag:
    skipIfFlagMissing: 1
    setsFlag:
    nextId: FK_P01_09_N2
    choices: []
  - id: FK_P01_09_N2
    speaker: "Ally Quinn"
    line: "Tell me straight. Is there anything in that file worth a year of my life?"
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag:
    skipIfFlagMissing: 1
    setsFlag:
    nextId: FK_P01_09_N3
    choices: []
  - id: FK_P01_09_N3
    speaker: "Del Cruz"
    line: "We looked. Properly. There's nothing. That's the truth, Quinny, and it took six weeks of good people's time to earn it."
    portrait: {fileID: 21300000, guid: de1a4b5c6d7e8f90a1b2c3d4e5f6a701, type: 3}
