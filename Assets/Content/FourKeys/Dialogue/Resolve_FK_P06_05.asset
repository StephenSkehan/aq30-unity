  nodes:
  - id: FK_P06_05_N1
    speaker: "Ally Quinn"
    line: "Tessa's frightened of being found. Eleven years of keeping quiet taught her something, and she said it plainly: a sentence can be an address."
    portrait: {fileID: 21300000, guid: e02460f0c092dde4891723eecbbdc368, type: 3}
    emotion: 5
