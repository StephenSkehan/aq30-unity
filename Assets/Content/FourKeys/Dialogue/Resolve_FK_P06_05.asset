  - id: FK_P06_05_N2
    speaker: "Ally Quinn"
    line: "She said yes anyway. I drove home slower than I drove up."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
