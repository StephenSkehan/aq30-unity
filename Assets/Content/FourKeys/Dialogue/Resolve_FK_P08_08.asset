  nodes:
  - id: FK_P08_08_N1
    speaker: "Ally Quinn"
    line: "If you were on the first train out of the inland halt on the Saturday morning Brad Collins's car was found at Kestrel Head, the 05:47, I'd like to hear from you."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P08_08_N2
    choices: []
  - id: FK_P08_08_N2
    speaker: "Ally Quinn"
    line: "Write to me. Not to anyone else. Not to the paper, not to a friend. To me."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P08_08_N3
    choices: []
  - id: FK_P08_08_N3
    speaker: "Ally Quinn"
    line: "The letter that started this is with Sergeant Del Cruz. The ask is the broadcast. That's the whole of this week's work in one sentence."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
