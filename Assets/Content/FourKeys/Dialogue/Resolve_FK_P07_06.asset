  startId: FK_P07_06_N1
  stageBackground: {fileID: 21300000, guid: b61e15d0a1b2c3d4e5f6a7b8c9d0e105, type: 3}
  nodes:
  - id: FK_P07_06_N1
    speaker: "Ruby Walker"
    line: "There's one thing I never told the others. One spring Brad told us he was at a wedding that weekend. A patient's son had run a marathon in another city the same weekend, and he showed me the results page. Brad's name was on it."
    portrait: {fileID: 0}
    emotion: 2
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P07_06_N2
    choices: []
  - id: FK_P07_06_N2
    speaker: "Ruby Walker"
    line: "Same day. I said nothing. It wasn't mine to say, and it didn't matter."
    portrait: {fileID: 0}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P07_06_N3
    choices: []
  - id: FK_P07_06_N3
    speaker: "Ally Quinn"
    line: "He lied about where he went. Once, provably, about nothing that mattered. Or so it seemed. It's on the board now, next to the others, no bigger than they are."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
