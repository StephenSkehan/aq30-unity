  nodes:
  - id: FK_P06_01_N1
    speaker: "Ally Quinn"
    line: "Three days of nothing. Then on the Wednesday, one letter, from a woman two hours up the coast."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P06_01_N2
    choices: []
  - id: FK_P06_01_N2
    speaker: "Ally Quinn"
    line: "She'd heard the ask. Did Margo say anything, to anyone. She wrote back: once. To me."
    portrait: {fileID: 21300000, guid: 7e03a4f198056f44ba2209764d9e8219, type: 3}
    emotion: 4
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P06_01_N3
    choices: []
  - id: FK_P06_01_N3
    speaker: "Ally Quinn"
    line: "There was a screenshot attached. I read it twice before I did anything else."
    portrait: {fileID: 21300000, guid: e02460f0c092dde4891723eecbbdc368, type: 3}
    emotion: 5
