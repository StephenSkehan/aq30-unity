  nodes:
  - id: FK_P09_07_N1
    speaker: "Ally Quinn"
    line: "Sergeant Del Cruz, Havenbay police, asked to meet me on the bench by the moorings. Not at the station."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
