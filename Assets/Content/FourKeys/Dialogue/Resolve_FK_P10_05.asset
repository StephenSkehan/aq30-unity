    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P10_05_N2
    choices: []
  - id: FK_P10_05_N2
    speaker: "Ally Quinn"
    line: "Six weeks of habits, told on this show by people who loved him. Heard by a woman who dusts his room. That's all it was."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
