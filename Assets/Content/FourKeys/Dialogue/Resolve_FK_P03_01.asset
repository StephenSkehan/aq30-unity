  nodes:
  - id: FK_P03_01_N1
    speaker: "Ally Quinn"
    line: "The Kestrel Corner Diner opens at six. Her menu boards are still out the front. Someone else chalks the prices in now."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P03_01_N2
    choices: []
  - id: FK_P03_01_N2
    speaker: "Ally Quinn"
    line: "Violet Moore lettered them. She lettered half the shopfronts in this town. You eat under her work and don't know it."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P03_01_N3
    choices: []
  - id: FK_P03_01_N3
    speaker: "Ally Quinn"
    line: "I had breakfast under it this morning. Then I asked the owner what she was like."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
