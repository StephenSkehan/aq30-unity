  startId: FK_P05_05_N1
  stageBackground: {fileID: 21300000, guid: b61e15d0a1b2c3d4e5f6a7b8c9d0e101, type: 3}
  nodes:
  - id: FK_P05_05_N1
    speaker: "Ally Quinn"
    line: "Here's what her last months look like from the outside. After the sixth meeting at Ruby's table, Margo stopped arguing. She still came. She sat, and she didn't say much."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P05_05_N2
    choices: []
  - id: FK_P05_05_N2
    speaker: "Ally Quinn"
    line: "After Brad went, she pulled away from Ruby. Fewer calls, then none. Ruby says her edges got sharper. Short with people who didn't deserve it."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P05_05_N3
    choices: []
  - id: FK_P05_05_N3
    speaker: "Ally Quinn"
    line: "And every second Sunday she drove somewhere. Nobody knew where. Nobody who asked got an answer."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P05_05_N4
    choices: []
  - id: FK_P05_05_N4
    speaker: "Ally Quinn"
    line: "That's all I have. A silence, but it has a shape."
    portrait: {fileID: 21300000, guid: e02460f0c092dde4891723eecbbdc368, type: 3}
    emotion: 5
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: 
    choices: []
