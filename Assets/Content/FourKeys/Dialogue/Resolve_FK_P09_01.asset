  startId: FK_P09_01_N1
  stageBackground: {fileID: 21300000, guid: be4bc156f1c11264dbd3b03b24114d6e, type: 3}
  nodes:
  - id: FK_P09_01_N1
    speaker: "Ally Quinn"
    line: "Four people wrote to me about the same panel, a hand-lettered sign that belonged to Violet. A café owner, a cinema owner, two signwriters. Tonight they're in one diner booth, and the tape's running."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P09_01_N2
    choices: []
  - id: FK_P09_01_N2
    speaker: "The café owner"
    line: "I only saw it the once. But you don't forget the gold."
    portrait: {fileID: 0}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P09_01_N3
    choices: []
  - id: FK_P09_01_N3
    speaker: "Ally Quinn"
    line: "Nobody at this table has seen it since Violet died. Nobody I've spoken to knows where it is. Four memories of one object. We start with what they agree on."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
