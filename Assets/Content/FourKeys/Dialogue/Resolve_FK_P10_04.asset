  stageBackground: {fileID: 21300000, guid: b61e15d0a1b2c3d4e5f6a7b8c9d0e101, type: 3}
  nodes:
  - id: FK_P10_04_N1
    speaker: "Ally Quinn"
    line: "Episode ten had one job. It had to sound exactly like episode nine."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P10_04_N2
    choices: []
  - id: FK_P10_04_N2
    speaker: "Ally Quinn"
    line: "Same length. Same running order. A recap, two listener letters, a word about the weather off the harbour. Nothing new. Nothing that sounded like a woman waiting for a phone call."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P10_04_N3
    choices: []
  - id: FK_P10_04_N3
    speaker: "Ally Quinn"
    line: "Because he listens. He's heard every week of this. And this week had to sound like all the others, or it was for nothing."
    portrait: {fileID: 21300000, guid: e02460f0c092dde4891723eecbbdc368, type: 3}
    emotion: 5
    voiceClip: {fileID: 0}
    waitForAudio: 0
