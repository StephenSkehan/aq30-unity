  startId: FK_P02_02_N1
  stageBackground: {fileID: 21300000, guid: 2451cd1fa43fb724bacf7ad8ad419c9b, type: 3}
  nodes:
  - id: FK_P02_02_N1
    speaker: "Ally Quinn"
    line: "Ruby kept her copy of the note. Four went out, all the same, two weeks after Violet died. I photographed hers at the kitchen table. It is under glass on my board now, in Violet's handwriting."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P02_02_N2
    choices: []
  - id: FK_P02_02_N2
    speaker: "Ally Quinn"
    line: "If you've got this, I'm dead, and I'm sorry about the timing. Go to my locker at the boatsheds by the slip. The padlock's new and these four keys are the only ones. Go together, all four of you, and read what's there together. Violet."
    portrait: {fileID: 21300000, guid: a6ca2348df1d653488455433cabdac99, type: 3}
    emotion: 2
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P02_02_N3
    choices: []
  - id: FK_P02_02_N3
    speaker: "Ally Quinn"
    line: "That's all of it."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
