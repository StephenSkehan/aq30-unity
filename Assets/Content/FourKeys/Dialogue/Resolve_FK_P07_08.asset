  stageBackground: {fileID: 21300000, guid: b61e15d0a1b2c3d4e5f6a7b8c9d0e104, type: 3}
  nodes:
  - id: FK_P07_08_N1
    speaker: "Ally Quinn"
    line: "I took the week to Gerald. He's my grandfather, a retired police detective who keeps the back booth at the Rusty Anchor, and he doesn't give you facts. He gives you method."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P07_08_N2
    choices: []
  - id: FK_P07_08_N2
    speaker: "Gerald"
    line: "A letter that passes examination isn't proved hers, love. It's just not proved anyone else's. Write that on your board before you write anything else."
    portrait: {fileID: 21300000, guid: 4e5f6a7b8c9d4e5f8a7b6c5d4e3f2a1b, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P07_08_N3
    choices: []
  - id: FK_P07_08_N3
    speaker: "Ally Quinn"
    line: "He's right. The police said it's hers, and I've said it's hers, and what we both mean is that nobody could show it wasn't."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
