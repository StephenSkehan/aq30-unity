    choices: []
  - id: FK_P01_07_N2
    speaker: "Ally Quinn"
    line: "Seven weeks after Violet's funeral, Brad drove to Kestrel Head, a place known for people who don't plan on coming home. His car was found there, but Brad never was."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag:
    skipIfFlagMissing: 1
    setsFlag:
    nextId: FK_P01_07_N3
    choices: []
  - id: FK_P01_07_N3
    speaker: "Ally Quinn"
    line: "Five months later, Margo's car appeared in the same car park. Three days after that, her body washed into the harbour."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
