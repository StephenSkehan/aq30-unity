  - id: FK_P01_07_N1
    speaker: "Ally Quinn"
    line: "Then the group began to disappear."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
