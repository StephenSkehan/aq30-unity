  m_Script: {fileID: 11500000, guid: 7e8140d05737a11468020c371c32ff33, type: 3}
  m_Name: Resolve_FK_P08_01
  m_EditorClassIdentifier: AQ.App::AQ.App.CaseGraph
  startId: FK_P08_01_N1
  stageBackground: {fileID: 21300000, guid: b61e15d0a1b2c3d4e5f6a7b8c9d0e107, type: 3}
  nodes:
  - id: FK_P08_01_N1
    speaker: "Ally Quinn"
    line: "A fishing skipper wrote to me this week. Two pages in longhand, from a harbour address."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P08_01_N2
    choices: []
  - id: FK_P08_01_N2
    speaker: "Ally Quinn"
    line: "He says a deckhand off his boat used to drink at, his words, Brad the signwriter's, the one with the van. I think he means Brad Collins. I can't be sure from the letter."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P08_01_N3
    choices: []
  - id: FK_P08_01_N3
    speaker: "Ally Quinn"
    line: "The deckhand went missing from the boat three years before Violet died. No family. Reported missing, closed as drifted. Never found."
    portrait: {fileID: 21300000, guid: e02460f0c092dde4891723eecbbdc368, type: 3}
    emotion: 5
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P08_01_N4
    choices: []
  - id: FK_P08_01_N4
    speaker: "Ally Quinn"
    line: "The skipper still keeps a small box of the man's things that were left aboard. In case anyone ever comes asking. Nobody has."
    portrait: {fileID: 21300000, guid: a6ca2348df1d653488455433cabdac99, type: 3}
    emotion: 2
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P08_01_N5
    choices: []
  - id: FK_P08_01_N5
    speaker: "Ally Quinn"
    line: "It went to Sergeant Del Cruz the same afternoon. It won't be aired. But there's a name beside Brad Collins's now, and I don't know what it's doing there."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: 
    choices: []
