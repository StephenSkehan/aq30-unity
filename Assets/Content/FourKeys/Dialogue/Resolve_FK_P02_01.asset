  startId: FK_P02_01_N1
  stageBackground: {fileID: 21300000, guid: bf108783271c436ebaaba28a69708349, type: 3}
  nodes:
  - id: FK_P02_01_N1
    speaker: "Ally Quinn"
    line: "Ruby Walker's kitchen. A pine table under the window, a stove in the corner. This is where the four sat with Violet's letter, week after week."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P02_01_N2
    choices: []
  - id: FK_P02_01_N2
    speaker: "Ally Quinn"
    line: "Before the letter, it was Tuesdays. Violet came for years, and Ruby had the stove lit before she knocked."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P02_01_N3
    choices: []
  - id: FK_P02_01_N3
    speaker: "Ruby Walker"
    line: "Stove lit, her at the door, then the same argument we'd had for years. That was the friendship. Tea?"
    portrait: {fileID: 21300000, guid: ee933f5d948e45808a57817fd2e9d4fe, type: 3}
    emotion: 1
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P02_01_N4
    choices: []
  - id: FK_P02_01_N4
    speaker: "Ally Quinn"
    line: "The argument was about whether Ruby's husband should be told. Told what?"
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P02_01_N5
    choices: []
  - id: FK_P02_01_N5
    speaker: "Ruby Walker"
    line: "You came for Violet, not my marriage. Leave him out of it. Anyway, tea?"
    portrait: {fileID: 21300000, guid: 4f3c2252e9b24f179e5e92bb42f0a6bb, type: 3}
    emotion: 5
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: 
    choices: []
