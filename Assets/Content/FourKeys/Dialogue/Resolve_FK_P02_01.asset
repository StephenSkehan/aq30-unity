  startId: FK_P02_01_N1
  stageBackground: {fileID: 21300000, guid: b61e15d0a1b2c3d4e5f6a7b8c9d0e105, type: 3}
  nodes:
  - id: FK_P02_01_N1
    speaker: "Ally Quinn"
    line: "Ruby Walker's kitchen. A pine table under the window, and a heater beside it. This is the table the four of them sat at with Violet's letter, week after week."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P02_01_N2
    choices: []
  - id: FK_P02_01_N2
    speaker: "Ally Quinn"
    line: "Before any of that it was Tuesdays. Violet came on Tuesday nights, for years, and Ruby had the heater on before she knocked."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P02_01_N3
    choices: []
  - id: FK_P02_01_N3
    speaker: "Ruby Walker"
    line: "Heater on, her at the door, then the same argument we'd had for years. Every Tuesday. That was the friendship. Anyway. Tea?"
    portrait: {fileID: 0}
    emotion: 1
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P02_01_N4
    choices: []
  - id: FK_P02_01_N4
    speaker: "Ally Quinn"
    line: "The argument was about whether Ruby's husband should be told. Told what, Ruby didn't say, and I don't know."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: 
    choices: []
