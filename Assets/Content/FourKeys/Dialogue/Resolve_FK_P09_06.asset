  nodes:
  - id: FK_P09_06_N1
    speaker: "A signwriter"
    line: "You'd know her brush from across a road. Sable, on a handle she cut from a broken oar. Green tape at the ferrule."
    portrait: {fileID: 0}
    emotion: 2
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P09_06_N2
    choices: []
  - id: FK_P09_06_N2
    speaker: "Ally Quinn"
    line: "That's what her hand looked like out in the world. An oar handle and a bit of green tape."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
