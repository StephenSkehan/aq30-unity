  m_Script: {fileID: 11500000, guid: 7e8140d05737a11468020c371c32ff33, type: 3}
  m_Name: Resolve_FK_P04_06
  m_EditorClassIdentifier: AQ.App::AQ.App.CaseGraph
  startId: FK_P04_06_N1
  stageBackground: {fileID: 21300000, guid: 2451cd1fa43fb724bacf7ad8ad419c9b, type: 3}
  nodes:
  - id: FK_P04_06_N1
    speaker: "Ally Quinn"
    line: "I went back through the tape that night and wrote Liam's answers down beside the letter's lines."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P04_06_N2
    choices: []
  - id: FK_P04_06_N2
    speaker: "Ally Quinn"
    line: "Every one of them is true. He asked about the boat, twice. He was in the bedroom. He hung the door. He fitted the gate and the latch and knew where the key was. He's told me all of it himself."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P04_06_N3
    choices: []
  - id: FK_P04_06_N3
    speaker: "Ally Quinn"
    line: "And every one of them, on its own, is a friend doing a job for a friend."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P04_06_N4
    choices: []
  - id: FK_P04_06_N4
    speaker: "Ally Quinn"
    line: "Laid side by side, they read like a case. There's a word for the way they fit him, and I'm not going to say it on air, because I can't source it to anyone but me."
    portrait: {fileID: 21300000, guid: e02460f0c092dde4891723eecbbdc368, type: 3}
    emotion: 5
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P04_06_N5
    choices: []
  - id: FK_P04_06_N5
    speaker: "Ally Quinn"
    line: "So here it is, off air. Built. It reads like a case built to fit him. I don't know that. I'm writing it down so I can't pretend later I didn't think it."
    portrait: {fileID: 21300000, guid: e02460f0c092dde4891723eecbbdc368, type: 3}
    emotion: 5
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: 
    choices: []
