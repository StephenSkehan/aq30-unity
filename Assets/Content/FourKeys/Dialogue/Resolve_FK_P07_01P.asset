  nodes:
  - id: FK_P07_01P_N1
    speaker: "Ally Quinn"
    line: "I paraphrased Margo's message. No quotation, no app and no Sunday journey went out."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: aq.fk.d3.paraphrase
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P07_01P_N2
    choices: []
  - id: FK_P07_01P_N2
    speaker: "Ally Quinn"
    line: "Nobody listening could trace the sentence back to the private room where Margo had put it."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: aq.fk.d3.paraphrase
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P07_01P_N3
    choices: []
  - id: FK_P07_01P_N3
    speaker: "Ally Quinn"
    line: "Tessa stayed out of the story and kept answering when I called."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: aq.fk.d3.paraphrase
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P07_01P_N4
    choices: []
  - id: FK_P07_01P_N4
    speaker: "Ally Quinn"
    line: "The city heard less. I kept the person who trusted me."
    portrait: {fileID: 21300000, guid: e02460f0c092dde4891723eecbbdc368, type: 3}
