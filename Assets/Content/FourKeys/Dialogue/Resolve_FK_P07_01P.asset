  startId: FK_P07_01P_N1
  stageBackground: {fileID: 21300000, guid: be4bc156f1c11264dbd3b03b24114d6e, type: 3}
  nodes:
  - id: FK_P07_01P_N1
    speaker: "Ally Quinn"
    line: "Last week I asked, in my own words, for anyone who'd seen the panel. One signwriter wrote back."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P07_01P_N2
    choices: []
  - id: FK_P07_01P_N2
    speaker: "Ally Quinn"
    line: "Black ground. Gold capitals and an ampersand. Her own alphabet, done better than she'd ever done it. A small mark bottom right that wasn't her name. And a crack across one corner."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P07_01P_N3
    choices: []
  - id: FK_P07_01P_N3
    speaker: "The café owner"
    line: "She had it on the chair beside her, wrapped up. I saw a corner of it when she moved it. Black, with gold letters. I couldn't tell you about any crack."
    portrait: {fileID: 0}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P07_01P_N4
    choices: []
  - id: FK_P07_01P_N4
    speaker: "Ally Quinn"
    line: "That's one letter and one memory. It took three mornings at that counter to get the second. It's thinner than I wanted, and I'm using what I've got."
    portrait: {fileID: 21300000, guid: e02460f0c092dde4891723eecbbdc368, type: 3}
    emotion: 5
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: 
    choices: []
