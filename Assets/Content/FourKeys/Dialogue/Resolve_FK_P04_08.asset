  stageBackground: {fileID: 21300000, guid: b61e15d0a1b2c3d4e5f6a7b8c9d0e107, type: 3}
  nodes:
  - id: FK_P04_08_N1
    speaker: "Ally Quinn"
    line: "The slip boatsheds, twenty to six in the morning. A row of brick boat lockers along the back wall, each with its own steel door. The slip road runs past the front, where the vans park."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P04_08_N2
    choices: []
  - id: FK_P04_08_N2
    speaker: "Ally Quinn"
    line: "There's no camera on any of it. The boat owners are here from first light. Anyone with a key and a reason can walk this corridor and nobody looks twice."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P04_08_N3
    choices: []
  - id: FK_P04_08_N3
    speaker: "Ally Quinn"
    line: "Violet's locker is a brick bay with a steel door. Her sister had the padlock cut. It's been empty since."
    portrait: {fileID: 21300000, guid: a6ca2348df1d653488455433cabdac99, type: 3}
    emotion: 2
    voiceClip: {fileID: 0}
