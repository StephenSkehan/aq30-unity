MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7e8140d05737a11468020c371c32ff33, type: 3}
  m_Name: Resolve_FK_P02_10
  m_EditorClassIdentifier: AQ.App::AQ.App.CaseGraph
  startId: FK_P02_10_N1
  stageBackground: {fileID: 21300000, guid: b61e15d0a1b2c3d4e5f6a7b8c9d0e102, type: 3}
  nodes:
  - id: FK_P02_10_N1
    speaker: "Ally Quinn"
    line: "This week I sat at Ruby Walker's kitchen table. It's pine. It's the table the four of them worked Violet's letter at, Saturday after Saturday, after they opened the locker."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P02_10_N2
    choices: []
  - id: FK_P02_10_N2
    speaker: "Ally Quinn"
    line: "Ruby read me the letter from behind the door. All of it but the lines about Violet's mother. Those she covered with her hand, and I haven't guessed at them."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P02_10_N3
    choices: []
  - id: FK_P02_10_N3
    speaker: "Ally Quinn"
    line: "She told me how the table went, meeting by meeting. According to Ruby, Brad argued Liam's side every week and lost every week. At the sixth meeting Margo stopped arguing. A week later Brad drove to Kestrel Head."
    portrait: {fileID: 21300000, guid: a6ca2348df1d653488455433cabdac99, type: 3}
    emotion: 2
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P02_10_N4
    choices: []
  - id: FK_P02_10_N4
    speaker: "Ally Quinn"
    line: "When Brad's rent stopped, his landlord sent his flat to Ruby in boxes. Passport, cards, tools, laptop. Police had seen them all before. I've been through every box. There's nothing odd in any of it."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P02_10_N5
    choices: []
  - id: FK_P02_10_N5
    speaker: "Ally Quinn"
    line: "Four things about Brad Collins, from Ruby. He moved his keys on the table, twice. He said thank you like it cost him. He ran at five. And he agreed with whoever had spoken last."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P02_10_N6
    choices: []
  - id: FK_P02_10_N6
    speaker: "Ally Quinn"
    line: "Everything you heard tonight came from Ruby Walker, at her own table, under her own name. In a town this size, that costs something."
    portrait: {fileID: 21300000, guid: e02460f0c092dde4891723eecbbdc368, type: 3}
    emotion: 5
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P02_10_N7
    choices: []
  - id: FK_P02_10_N7
    speaker: "Ally Quinn"
    line: "Next week I'll read you Violet's letter whole, every line Ruby read me. They go out in Ruby's voice, and she'll carry them round this town. She knows that. This is Echoes of Havenbay, I'm Ally Quinn. Goodnight for now, Harbour. Sleep tight."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: aq.fk.d1.aired
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P02_10_N8
    choices: []
  - id: FK_P02_10_N8
    speaker: "Ally Quinn"
    line: "Next week you'll hear the parts of Violet's letter I can check with someone other than Ruby. You'll hear less. The rest stays at her table. This is Echoes of Havenbay, I'm Ally Quinn. Goodnight for now, Harbour. Sleep tight."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: aq.fk.d1.held
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: 
    choices: []
