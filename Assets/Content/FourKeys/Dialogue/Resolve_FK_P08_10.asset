  stageBackground: {fileID: 21300000, guid: b61e15d0a1b2c3d4e5f6a7b8c9d0e102, type: 3}
  nodes:
  - id: FK_P08_10_N1
    speaker: "Ally Quinn"
    line: "Episode eight went out at nine. It's the shortest one yet. A question about a train and nothing else new, because nothing else is mine to say."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P08_10_N2
    choices: []
  - id: FK_P08_10_N2
    speaker: "Ally Quinn"
    line: "The week empties out after that. Two letters with Sergeant Del Cruz, one question on the air, and a wall I read differently now."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P08_10_N3
    choices: []
  - id: FK_P08_10_N3
    speaker: "Ally Quinn"
    line: "If you were on the 05:47 that Saturday, write to me, not to anyone else. I'll say the rest when I can say it properly. This is Echoes of Havenbay, I'm Ally Quinn. Goodnight for now, Harbour. Sleep tight."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
