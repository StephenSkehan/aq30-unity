  m_Name: Resolve_FK_P03_08
  m_EditorClassIdentifier: AQ.App::AQ.App.CaseGraph
  startId: FK_P03_08_N1
  stageBackground: {fileID: 21300000, guid: b61e15d0a1b2c3d4e5f6a7b8c9d0e107, type: 3}
  nodes:
  - id: FK_P03_08_N1
    speaker: "Ally Quinn"
    line: "Six weeks before she died, Violet fell on the slip here at the moorings. It's on her medical record, and the coroner read it as a prior fall."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P03_08_N2
    choices: []
  - id: FK_P03_08_N2
    speaker: "Ally Quinn"
    line: "It was witnessed. She was walking backwards on the weed, talking to another swimmer, and went down. Bruised all over. She swam anyway."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P03_08_N3
    choices: []
  - id: FK_P03_08_N3
    speaker: "Ally Quinn"
    line: "Ruby treated the bruising at the surgery that week. Nobody called it anything, because it wasn't anything. A wet slip and a woman not looking where she was going."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P03_08_N4
    choices: []
  - id: FK_P03_08_N4
    speaker: "Ally Quinn"
    line: "I'm telling you because it's on the record and you'd find it. It was innocent, and someone saw it happen."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
