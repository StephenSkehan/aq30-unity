  m_Script: {fileID: 11500000, guid: 7e8140d05737a11468020c371c32ff33, type: 3}
  m_Name: Resolve_FK_P02_06
  m_EditorClassIdentifier: AQ.App::AQ.App.CaseGraph
  startId: FK_P02_06_N1
  stageBackground: {fileID: 21300000, guid: bf108783271c436ebaaba28a69708349, type: 3}
  nodes:
  - id: FK_P02_06_N1
    speaker: "Ruby Walker"
    line: "When we opened the locker, the first thing was relief. Then shame, because relief meant we'd believed she might name one of us."
    portrait: {fileID: 21300000, guid: 0daf7b4e2afb4baca0c6660666687b94, type: 3}
    emotion: 2
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P02_06_N2
    choices: []
  - id: FK_P02_06_N2
    speaker: "Ally Quinn"
    line: "The next evening you did the arithmetic."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P02_06_N3
    choices: []
  - id: FK_P02_06_N3
    speaker: "Ruby Walker"
    line: "New lock. Only four told. Something moved after. Key taken in, it stopped. Liam found the pot empty, broke a pane, and the back door was latched."
    portrait: {fileID: 21300000, guid: 4f3c2252e9b24f179e5e92bb42f0a6bb, type: 3}
    emotion: 5
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P02_06_N4
    choices: []
  - id: FK_P02_06_N4
    speaker: "Ally Quinn"
    line: "But the wall could be climbed. Someone could have watched Violet use the pot."
    portrait: {fileID: 21300000, guid: ae0c3985c1991244d8ee72fa0756eb08, type: 3}
    emotion: 6
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P02_06_N5
    choices: []
  - id: FK_P02_06_N5
    speaker: "Ruby Walker"
    line: "I know. We looked outward: no cleaner, lodger or tradesman, and an estranged sister. Then Monday: me on shift, Margo home, Liam at the yard, Brad at home. Nobody had an alibi. Liam had the least."
    portrait: {fileID: 21300000, guid: 05596daefe01434b8af754b91499af1a, type: 3}
    emotion: 3
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: 
    choices: []
