  nodes:
  - id: FK_P02_06_N1
    speaker: "Ally Quinn"
    line: "When Brad Collins's rent stopped, his landlord boxed up his flat and sent the boxes to Ruby. They're at hers now."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P02_06_N2
    choices: []
  - id: FK_P02_06_N2
    speaker: "Ally Quinn"
    line: "Police had been through the flat before it was boxed. Passport, bank cards, tools, laptop. All there. All still there."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P02_06_N3
    choices: []
  - id: FK_P02_06_N3
    speaker: "Ally Quinn"
    line: "Ruby and I went through every box at the table, over days. Clothes, tools, paperwork. A whole flat. There's nothing odd in any of it. Days of careful nothing."
    portrait: {fileID: 21300000, guid: a6ca2348df1d653488455433cabdac99, type: 3}
    emotion: 2
    voiceClip: {fileID: 0}
    waitForAudio: 0
