  - id: FK_P09_04_N2
    speaker: "Ally Quinn"
    line: "Not a maker's stamp either. Not one anybody at the table recognised, and two of them letter signs for a living."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
