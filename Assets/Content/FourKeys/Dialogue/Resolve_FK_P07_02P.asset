  nodes:
  - id: FK_P07_02P_N1
    speaker: "Ally Quinn"
    line: "Two signwriters answered my request about the panel. Neither knew the other had written."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
