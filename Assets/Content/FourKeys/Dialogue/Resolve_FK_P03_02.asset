  startId: FK_P03_02_N1
  stageBackground: {fileID: 21300000, guid: be4bc156f1c11264dbd3b03b24114d6e, type: 3}
  nodes:
  - id: FK_P03_02_N1
    speaker: "Ally Quinn"
    line: "The diner's owner knew Violet for years. I asked about her last months."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P03_02_N2
    choices: []
  - id: FK_P03_02_N2
    speaker: "The diner's owner"
    line: "She was in most mornings. Near the end she said she was calling in what she was owed. For the lawyer, she said. I didn't ask who. You didn't, with Violet."
    portrait: {fileID: 0}
    emotion: 2
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P03_02_N3
    choices: []
  - id: FK_P03_02_N3
    speaker: "Ally Quinn"
    line: "Calling in what she was owed. For the lawyer. That's all of it. No name, no amount, no date."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P03_02_N4
    choices: []
  - id: FK_P03_02_N4
    speaker: "Ally Quinn"
    line: "But money moved in her last months. Until this morning I had a letter and a kitchen table. Now I have money moving."
    portrait: {fileID: 21300000, guid: e02460f0c092dde4891723eecbbdc368, type: 3}
    emotion: 5
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P03_02_N5
    choices: []
  - id: FK_P03_02_N5
    speaker: "Ally Quinn"
    line: "That doesn't give suspicion a face. It gives it a category. I'll take a category."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
