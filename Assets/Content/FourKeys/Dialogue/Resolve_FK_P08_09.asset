  m_Script: {fileID: 11500000, guid: 7e8140d05737a11468020c371c32ff33, type: 3}
  m_Name: Resolve_FK_P08_09
  m_EditorClassIdentifier: AQ.App::AQ.App.CaseGraph
  startId: FK_P08_09_N1
  stageBackground: {fileID: 21300000, guid: 2451cd1fa43fb724bacf7ad8ad419c9b, type: 3}
  nodes:
  - id: FK_P08_09_N1
    speaker: "Ally Quinn"
    line: "On Saturday night I took every card off the wall and read them again, in one sitting, in order. The letter, the keys, the store door at twenty past seven, the box on the boat, the boots."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P08_09_N2
    choices: []
  - id: FK_P08_09_N2
    speaker: "Ally Quinn"
    line: "I read them against a possibility. I'm not going to say it. Not here, not on air, not until somebody who can prove it says it first."
    portrait: {fileID: 21300000, guid: e02460f0c092dde4891723eecbbdc368, type: 3}
    emotion: 5
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P08_09_N3
    choices: []
  - id: FK_P08_09_N3
    speaker: "Ally Quinn"
    line: "Some of the cards read differently. Not all of them. Enough."
    portrait: {fileID: 21300000, guid: 7e03a4f198056f44ba2209764d9e8219, type: 3}
    emotion: 4
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P08_09_N4
    choices: []
  - id: FK_P08_09_N4
    speaker: "Ally Quinn"
    line: "My note at the bottom of the board, in my own writing, says one thing. I have stopped saying \"was\"."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P08_09_N5
    choices: []
  - id: FK_P08_09_N5
    speaker: "Ally Quinn"
    line: "That's a change in me. It isn't a change in what I know. The broadcast stays where the facts are."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: 
    choices: []
