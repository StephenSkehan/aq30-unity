  nodes:
  - id: FK_P10_07_N1
    speaker: "Ally Quinn"
    line: "Day 333. Del rang early. A man had been arrested four hundred miles away."
    portrait: {fileID: 21300000, guid: 7e03a4f198056f44ba2209764d9e8219, type: 3}
    emotion: 4
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P10_07_N2
    choices: []
  - id: FK_P10_07_N2
    speaker: "Ally Quinn"
    line: "The name he'd been living under wasn't new. It had sat for three years in a missing-person file in Del's own precinct. The deckhand's name, from the skipper's letter."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P10_07_N3
    choices: []
  - id: FK_P10_07_N3
    speaker: "Ally Quinn"
    line: "Brad Collins. Alive. I'd carried that for weeks without saying it. It didn't land like news. It landed like something I already knew, said out loud by someone else."
    portrait: {fileID: 21300000, guid: a6ca2348df1d653488455433cabdac99, type: 3}
    emotion: 2
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
