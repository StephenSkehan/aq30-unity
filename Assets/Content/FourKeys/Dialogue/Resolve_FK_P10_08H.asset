  stageBackground: {fileID: 21300000, guid: b61e15d0a1b2c3d4e5f6a7b8c9d0e101, type: 3}
  nodes:
  - id: FK_P10_08H_N1
    speaker: "Ally Quinn"
    line: "Because I held the mark back, Del had one thing that had never been said out loud anywhere."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P10_08H_N2
    choices: []
  - id: FK_P10_08H_N2
    speaker: "Ally Quinn"
    line: "He asked her one question about what had hung on that wall. Her answer matched the thing I'd never said. One chain, checked link by link, and it held."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P10_08H_N3
    choices: []
  - id: FK_P10_08H_N3
    speaker: "Ally Quinn"
    line: "The mark never went out. It never will. It's in a file, and it's staying there."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
