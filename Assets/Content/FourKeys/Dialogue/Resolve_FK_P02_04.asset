  - id: FK_P02_04_N2
    speaker: "Ruby Walker"
    line: "You're talking about me like I'm not in the room."
    portrait: {fileID: 21300000, guid: 0bf73a905b8a4f11a7398a494390fc6f, type: 3}
    emotion: 6
    voiceClip: {fileID: 0}
    waitForAudio: 0
