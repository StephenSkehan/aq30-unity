  - id: FK_P02_04_N1
    speaker: "Ally Quinn"
    line: "Ruby Walker is in her mid thirties, a practice nurse at the surgery on Wharf Street."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
