    setsFlag: 
    nextId: FK_P02_04_N4
    choices: []
  - id: FK_P02_04_N4
    speaker: "Ruby Walker"
    line: "Six years sober. The glass is tonic. Say that too, before somebody else decides what it is."
    portrait: {fileID: 21300000, guid: 3eda8c3a8ba44593b8d95260ba6b7487, type: 3}
