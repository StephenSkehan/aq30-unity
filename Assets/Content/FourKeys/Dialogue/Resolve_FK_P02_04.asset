    choices: []
  - id: FK_P02_04_N3
    speaker: "Ally Quinn"
    line: "When she is frightened, she talks. She fills the room, gives you a job and makes tea nobody asked for."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
