    setsFlag: 
    nextId: FK_P06_09_N2
    choices: []
  - id: FK_P06_09_N2
    speaker: "Ally Quinn"
    line: "Not it can't be true. Not it can't be hers. It can't mean that. Margo had a meaning in her head, and she was refusing it."
    portrait: {fileID: 21300000, guid: ae0c3985c1991244d8ee72fa0756eb08, type: 3}
    emotion: 6
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P06_09_N3
    choices: []
  - id: FK_P06_09_N3
    speaker: "Ally Quinn"
    line: "I've written the question on a card and pinned it under her sentence. What couldn't it mean? Nobody alive can tell me. So it stays up."
    portrait: {fileID: 21300000, guid: e02460f0c092dde4891723eecbbdc368, type: 3}
