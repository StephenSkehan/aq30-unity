  nodes:
  - id: FK_P06_09_N1
    speaker: "Ally Quinn"
    line: "One more word, and then I'll leave it. That. It can't mean that."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
