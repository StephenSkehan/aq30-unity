  nodes:
  - id: FK_P05_08_N1
    speaker: "Ally Quinn"
    line: "I've written this next part down, because I want to get it right and not add to it."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
