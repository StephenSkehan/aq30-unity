    setsFlag: 
    nextId: FK_P05_08_N2
    choices: []
  - id: FK_P05_08_N2
    speaker: "Ally Quinn"
    line: "Margo Rivera. In the months before she died. Did she say anything, to anyone. About the letter, about Brad, about the four of them. About anything at all."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P05_08_N3
    choices: []
  - id: FK_P05_08_N3
    speaker: "Ally Quinn"
    line: "A sentence in a car park. Something at a till. Something she started and didn't finish. If she said it to you, write to me. Not to anyone else. Write to me."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
