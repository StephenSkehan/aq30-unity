  nodes:
  - id: FK_P08_03_N1
    speaker: "Ally Quinn"
    line: "The harbour master keeps a ledger of leavers. Itinerant crews, men who work between tides, a line each when they don't come back."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
