    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P08_03_N2
    choices: []
  - id: FK_P08_03_N2
    speaker: "Ally Quinn"
    line: "Most of those lines close the same way. Drifted. There are men the sea is allowed to keep, and nobody argues."
    portrait: {fileID: 21300000, guid: a6ca2348df1d653488455433cabdac99, type: 3}
