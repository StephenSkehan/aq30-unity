  nodes:
  - id: FK_P04_04_N1
    speaker: "Ally Quinn"
    line: "The letter had lines about Liam. I read each of them to him."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P04_04_N2
    choices: []
  - id: FK_P04_04_N2
    speaker: "Liam Bryce"
    line: "March and July, I asked her to let me take her mum out to the point on the boat. She said no both times. It had been four years. I thought if somebody offered, she wouldn't have to be the one who decided."
    portrait: {fileID: 0}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P04_04_N3
    choices: []
  - id: FK_P04_04_N3
    speaker: "Ally Quinn"
    line: "And the back bedroom."
    portrait: {fileID: 21300000, guid: 792b5f88f6dd2724d84b6954cc0b5fad, type: 3}
    emotion: 0
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: FK_P04_04_N4
    choices: []
  - id: FK_P04_04_N4
    speaker: "Liam Bryce"
    line: "Once, in spring. The window catch had gone and she asked me to fix it. I rehung the back door the same visit. I know how that sounded at Ruby's table. I was sitting at it."
    portrait: {fileID: 0}
    emotion: 5
    voiceClip: {fileID: 0}
    waitForAudio: 0
    requiresFlag: 
    skipIfFlagMissing: 1
    setsFlag: 
    nextId: 
    choices: []
